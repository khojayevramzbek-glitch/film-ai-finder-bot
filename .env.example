# ================================================================
# 🎬 AI Movie Finder Telegram Bot - Sozlamalar Fayli
# ================================================================

# 1. Telegram Bot Token (@BotFather dan olingan)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Google Gemini API Kalitlari (Cheksiz ishlashi uchun 1 ta yoki 10+ ta kalitni vergul bilan ajratib yozing)
# Masalan: AIzaSyA123...,AIzaSyB456...,AIzaSyC789...
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# 3. TMDb API Kalitlari (1 ta yoki bir nechta vergul bilan)
TMDB_API_KEYS=your_tmdb_api_key_1,your_tmdb_api_key_2

# 4. Gemini Model nomi (Tavsiya: gemini-2.0-flash yoki gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# 5. Yuklab olinadigan videoning maksimal hajmi (MB da)
MAX_VIDEO_SIZE_MB=50
